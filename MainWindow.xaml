<Window x:Class="CSV.Convertor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV to EXCEL" Height="350" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CSV to EXCEL" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Разделитель -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="Разделитель:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Name="cmbDelimiter" Width="164" FontSize="14" SelectedIndex="0">
                <ComboBoxItem Content="; (точка с запятой)" Tag=";"/>
                <ComboBoxItem Content=", (запятая)" Tag=","/>
                <ComboBoxItem Content="TAB" Tag="\t"/>
                <ComboBoxItem Content="| (вертикальная черта)" Tag="|"/>
            </ComboBox>
            <CheckBox Name="chkAutoDetect" Content="Автоопределение" FontSize="14" 
                      IsChecked="True" Margin="15,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Кнопка загрузки -->
        <Button Grid.Row="2" Name="btnLoad" Content="📂 Загрузить CSV" FontSize="16" 
                Padding="20,10" HorizontalAlignment="Center" Click="BtnLoad_Click" 
                Width="206" Margin="0,0,0,20"/>

        <!-- Прогресс-бар -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <ProgressBar Name="progressBar" Width="423" Height="25" Minimum="0" Maximum="100" 
                         Value="0" Margin="0,0,10,0"/>
            <TextBlock Name="lblProgress" Text="0%" FontSize="14" VerticalAlignment="Center" Width="76" TextAlignment="Center"/>
        </StackPanel>

        <!-- Статус -->
        <TextBlock Grid.Row="4" Name="lblStatus" Text="Готов к работе" FontSize="12" 
                   Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button Name="btnOpenXlsx" Content="📂 Открыть XLSX" FontSize="14" 
                    Padding="15,8" Click="BtnOpenXlsx_Click" Margin="0,0,15,0"/>
            <Button Name="btnExit" Content="❌ Выход" FontSize="14" 
                    Padding="15,8" Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>